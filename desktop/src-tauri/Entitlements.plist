<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (enabled by Tauri's codesign step) blocks audio capture
	     unless the binary holds this entitlement — NSMicrophoneUsageDescription
	     alone is not enough. Required for live transcription (getUserMedia). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
